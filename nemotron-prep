    "import os, subprocess, sys, json\n",
    "import importlib.metadata as imd\n",
    "\n",
    "os.makedirs('/kaggle/working/wheelhouse', exist_ok=True)\n",
    "\n",
    "# These are the packages the training notebook needs to install offline.\n",
    "# transformers is pinned to the exact version installed above.\n",
    "tf_ver = imd.version('transformers')   # e.g. '4.51.3'\n",
    "print(f'Will pin transformers=={tf_ver} in wheelhouse')\n",
    "\n",
    "target_packages = [\n",
    "    f'transformers=={tf_ver}',   # PINNED — must match unsloth requirement\n",
    "    'unsloth',\n",
    "    'unsloth-zoo',\n",
    "    'trl',\n",
    "    'peft',\n",
    "    'bitsandbytes',\n",
    "    'cut-cross-entropy',\n",
    "    'xformers',\n",
    "    'triton',\n",
    "    'accelerate',\n",
    "    'datasets>=2.21.0,<5',\n",
    "    'huggingface_hub>=0.25.0',\n",
    "    'causal-conv1d',   \n",
    "    'mamba-ssm', \n",
    "]\n",
    "\n",
    "print('\\nDownloading wheels...')\n",
    "\n",
    "for pkg in target_packages:\n",
    "    display_name = pkg.split('>=')[0].split('==')[0]\n",
    "    print(f'  {display_name}...', end=' ', flush=True)\n",
    "    result = subprocess.run(\n",
    "        [sys.executable, '-m', 'pip', 'download', pkg,\n",
    "         '--dest', '/kaggle/working/wheelhouse', '--quiet'],\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if result.returncode != 0:\n",
    "        print(f'WARN: {result.stderr.strip()[:200]}')\n",
    "    else:\n",
    "        print('ok')\n",
    "\n",
    "# Write version manifest — training notebook reads this\n",
    "manifest_packages = [\n",
    "    'transformers', 'unsloth', 'unsloth_zoo', 'trl', 'peft',\n",
    "    'bitsandbytes', 'accelerate', 'datasets', 'huggingface_hub',\n",
    "    'causal_conv1d', 'mamba_ssm',\n",
    "]\n",
    "manifest = {}\n",
    "for pkg in manifest_packages:\n",
    "    try:\n",
    "        manifest[pkg] = imd.version(pkg)\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
