    "# Cell 6 — Download NuminaMath-CoT dataset\n",
    "\n",
    "from datasets import load_dataset\n",
    "import re, os\n",
    "\n",
    "DATASET_DIR  = '/kaggle/working/numinamath'\n",
    "PARQUET_PATH = os.path.join(DATASET_DIR, 'train.parquet')\n",
    "os.makedirs(DATASET_DIR, exist_ok=True)\n",
    "\n",
    "if os.path.exists(PARQUET_PATH):\n",
    "    size = os.path.getsize(PARQUET_PATH) / 1e6\n",
    "    print(f'train.parquet already exists ({size:.1f} MB) — skipping download.')\n",
    "else:\n",
    "    print('Downloading NuminaMath-CoT (this may take a few minutes)...')\n",
    "    ds = load_dataset('AI-MO/NuminaMath-CoT', split='train')\n",
    "    print(f'Raw dataset: {len(ds):,} examples')\n",
    "\n",
    "    ds = ds.filter(\n",
    "        lambda x: bool(re.search(r'\\\\boxed\\{', x.get('solution', ''))),\n",
    "        num_proc=2\n",
    "    )\n",
    "    print(f'After \\\\boxed{{}} filter: {len(ds):,} examples')\n",
    "\n",
    "    ds = ds.shuffle(seed=42).select(range(min(60_000, len(ds))))\n",
    "    print(f'Saving {len(ds):,} examples...')\n",
    "    ds.to_parquet(PARQUET_PATH)\n",
    "    size = os.path.getsize(PARQUET_PATH) / 1e6\n",
    "    print(f'Saved: train.parquet ({size:.1f} MB)')"
   ]
