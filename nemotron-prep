rate>=0.30.0',\n    'peft>=0.10.0',\n    'cut-cross-entropy',\n    'triton',\n)\nprint('Core deps OK.')\n\nimport importlib.metadata as imd\nprint('\\nResolved versions:')\nfor pkg in ['transformers', 'unsloth', 'trl', 'peft', 'bitsandbytes']:\n    try:\n        print(f'  {pkg}: {imd.version(pkg)}')\n    except Exception:\n        print(f'  {pkg}: NOT FOUND')\n\nimport transformers\ntf_major, tf_minor = [int(x) for x in transformers.__version__.split('.')[:2]]\nassert (tf_major, tf_minor) >= (4, 51), (\n    f'transformers {transformers.__version__} is too old — need >=4.51'\n)\nprint(f'\\ntransformers {transformers.__version__} — OK!')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-08T08:03:14.057363Z","iopub.execute_input":"2026-05-08T08:03:14.057694Z","iopub.status.idle":"2026-05-08T08:03:51.142941Z","shell.execute_reply.started":"2026-05-08T08:03:14.057670Z","shell.execute_reply":"2026-05-08T08:03:51.142275Z"}},"outputs":[{"name":"stdout","text":"Installing unsloth (with deps)...\nInstalling remaining core deps...\nCore deps OK.\n\nResolved versions:\n  transformers: 5.5.0\n  unsloth: 2026.5.2\n  trl: 0.24.0\n  peft: 0.18.1\n  bitsandbytes: 0.49.2\n\ntransformers 5.5.0 — OK!\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# Cell 2 — Download mamba_ssm + causal_conv1d binary wheels\n#\n# CRITICAL FIX vs v3/v4:\n#   Wheels now use simplified cu tags: cu12 (not cu124), cu11 (not cu121)\n#   e.g. mamba_ssm-2.3.1+cu12torch2.6cxx11abiFALSE-cp310-cp310-linux_x86_64.whl\n#   This cell queries the GitHub expanded_assets API to find the exact matching\n#   wheel for your runtime environment before downloading.\n\nimport urllib.request, os, glob, re, json\nimport torch\n\nWHEEL_DIR = '/kaggle/working/wheelhouse'\nos.makedirs(WHEEL_DIR, exist_ok=True)\n\nCU_TAG    = getattr(__builtins__, '_NP_CU_TAG',    'cu12')\nTORCH_TAG = getattr(__builtins__, '_NP_TORCH_TAG', '2.6')\nPY_TAG    = getattr(__builtins__, '_NP_PY_TAG',    'cp310')\n\nTARGETS = [\n    {\n        'pip_name':  'causal-conv1d',\n        'pkg_base':  'causal_conv1d',\n        'releases':  [\n            ('v1.6.1.post4', 'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.6.1.post4/'),\n            ('v1.6.0',       'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.6.0/'),\n            ('v1.5.0',       'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.5.0/'),\n        ],\n        'assets_urls': [\n            'https://github.com/Dao-AILab/causal-conv1d/releases/expanded_assets/v1.6.1.post4',\n            'https://github.com/Dao-AILab/causal-conv1d/releases/expanded_assets/v1.6.0',\n            'https://github.com/Dao-AILab/causal-conv1d/releases/expanded_assets/v1.5.0',\n        ],\n    },\n    {\n        'pip_name':  'mamba-ssm',\n        'pkg_base':  'mamba_ssm',\n        'releases':  [\n            ('v2.3.1', 'https://github.com/state-spaces/mamba/releases/download/v2.3.1/'),\n            ('v2.2.4', 'https://github.com/state-spaces/mamba/releases/download/v2.2.4/'),\n        ],\n        'assets_urls': [\n            'https://github.com/state-spaces/mamba/releases/expanded_assets/v2.3.1',\n            'https://github.com/state-spaces/mamba/releases/expanded_assets/v2.2.4',\n        ],\n    },\n]\n\ndef fetch_html(url):\n    req = urllib.request.Request(url, headers={'User-Agent': 'python-requests/2.31.0'})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return r.read().decode('utf-8', errors='ignore')\n\ndef find_best_wheel(assets_urls, pkg_base, cu_tag, torch_tag, py_tag):\n    \"\"\"\n    Queries GitHub expanded_assets pages to find the best matching wheel.\n    Priority: exact cu+torch+py match, then fallback variants.\n    Returns (download_url, wheel_filename) or (None, None).\n    \"\"\"\n    all_wheels = []  # (filename, download_url)\n    for assets_url in assets_urls:\n        base_dl = assets_url.replace('/expanded_assets/', '/download/')\n        # Extract the release tag from URL\n        tag = assets_url.split('/')[-1]\n        try:\n            html = fetch_html(assets_url)\n            # Find wheel filenames from asset links\n            pattern = rf'/{re.escape(pkg_base.replace(\"_\",\"-\"))}/releases/download/{re.escape(tag)}/([^\"\\s<>]+\\.whl)'\n            # Also try with underscores\n            pattern2 = rf'/releases/download/{re.escape(tag)}/({re.escape(pkg_base)}[^\"\\s<>]+\\.whl)'\n            names = re.findall(pattern, html) + re.findall(pattern2, html)\n            for name in set(names):\n                dl_url = base_dl.rsplit('/', 1)[0] + '/' + tag + '/' + name\n                all_wheels.append((name, dl_url))\n        except Exception as e:\n            print(f'    Could not fetch assets from {assets_url}: {e}')\n            continue\n\n    if not all_wheels:\n        return None, None\n\n    # Score each wheel — higher = better match\n    def score(name):\n        s = 0\n        if py_tag in name:              s += 100\n        if cu_tag + 'torch' in name:    s += 50\n        if f'torch{torch_tag}' in name: s += 25\n        if 'linux_x86_64' in name:      s += 10\n        if 'FALSE' in name:             s += 5   # cxx11abiFALSE is more common on Kaggle\n        return s\n\n    # Filter to x86_64 linux only\n    candidates = [(n, u) for n, u in all_wheels if 'linux_x86_64' in n and py_tag in n]\n    if not candidates:\n        # Relax py constraint\n        candidates = [(n, u) for n, u in all_wheels if 'linux_x86_64' in n]\n\n    if not candidates:\n        return None, None\n\n    best = max(candidates, key=lambda x: score(x[0]))\n    return best[1], best[0]\n\ndef try_download(url, dest):\n    try:\n        req = urllib.request.Request(url, headers={'User-Agent': 'python-requests/2.31.0'})\n        urllib.request.urlretrieve(url, dest)\n        size = os.path.getsize(dest) / 1e6\n        if size < 0.5:  # Real wheels are several MB; tiny = 404 HTML\n            os.remove(dest)\n            return False\n        print(f'  Downloaded: {os.path.basename(dest)} ({size:.1f} MB)')\n        return True\n    except Exception as e:\n        if os.path.exists(dest):\n            os.remove(dest)\n        return False\n\n# Remove stale non-wheel archives\nfor bad_ext in ['tar.gz', 'zip']:\n    for bad in glob.glob(os.path.join(WHEEL_DIR, f'*causal*{bad_ext}')) + \\\n               glob.glob(os.path.join(WHEEL_DIR, f'*mamba*{bad_ext}')):\n        os.remove(bad)\n        print(f'Removed stale archive: {os.path.basename(bad)}')\n\ndownload_results = {}\n\nfor target in TARGETS:\n    pkg_base  = target['pkg_base']\n    pip_name  = target['pip_name']\n    print(f'\\n--- {pkg_base} ---')\n\n    existing = glob.glob(os.path.join(WHEEL_DIR, f'{pkg_base}*.whl'))\n    if existing:\n        print(f'  Already in wheelhouse: {os.path.basename(existing[0])}')\n        download_results[pkg_base] = existing[0]\n        continue\n\n    print(f'  Querying GitHub for matching wheel (cu={CU_TAG}, torch={TORCH_TAG}, py={PY_TAG})...')\n    dl_url, whl_name = find_best_wheel(\n        target['assets_urls'], pkg_base, CU_TAG, TORCH_TAG, PY_TAG\n    )\n\n    if not dl_url:\n        print(f'  ERROR: Could not find any matching wheel for {pkg_base}')\n        download_results[pkg_base] = None\n        continue\n\n    print(f'  Best match: {whl_name}')\n    dest = os.path.join(WHEEL_DIR, whl_name)\n    if try_download(dl_url, dest):\n        download_results[pkg_base] = dest\n    else:\n        # Fallback: try all release URLs directly with constructed name\n        print(f'  Direct download failed, trying constructed URLs...')\n        found = False\n        for tag, base_url in target['releases']:\n            for cxx in ['FALSE', 'TRUE']:\n                # Use simplified cu tag (cu12, not cu124)\n                constructed = f'{pkg_base}-{tag.lstrip(\"v\")}+{CU_TAG}torch{TORCH_TAG}cxx11abi{cxx}-{PY_TAG}-{PY_TAG}-linux_x86_64.whl'\n                url  = base_url + constructed\n                dest = os.path.join(WHEEL_DIR, constructed)\n                if try_download(url, dest):\n                    download_results[pkg_base] = dest\n                    found = True\n                    break\n            if found: break\n        if not found:\n            download_results[pkg_base] = None\n\nprint('\\n=== Download summary ===')\nfor k, v in download_results.items():\n    print(f'  {k}: {\"OK — \" + os.path.basename(v) if v else \"MISSING\"}')\n\nmissing = [k for k, v in download_results.items() if not v]\nassert not missing, (\n    f'FAILED to download required wheels: {missing}\\n'\n    f'Runtime: CUDA={torch.version.cuda}, torch={torch.__version__}, py={PY_TAG}\\n'\n    f'Check releases manually:\\n'\n    f'  https://github.com/Dao-AILab/causal-conv1d/releases\\n'\n    f'  https://github.com/state-spaces/mamba/releases'\n)\nprint('\\nAll required wheels downloaded!')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-08T08:03:51.143952Z","iopub.execute_input":"2026-05-08T08:03:51.144427Z","iopub.status.idle":"2026-05-08T08:03:55.886850Z","shell.execute_reply.started":"2026-05-08T08:03:51.144403Z","shell.execute_reply":"2026-05-08T08:03:55.886218Z"}},"outputs":[{"name":"stdout","text":"\n--- causal_conv1d ---\n  Querying GitHub for matching wheel (cu=cu12, torch=2.10, py=cp312)...\n  Best match: causal_conv1d-1.6.1+cu12torch2.10cxx11abiTRUE-cp312-cp312-linux_x86_64.whl\n  Downloaded: causal_conv1d-1.6.1+cu12torch2.10cxx11abiTRUE-cp312-cp312-linux_x86_64.whl (287.6 MB)\n\n--- mamba_ssm ---\n  Querying GitHub for matching wheel (cu=cu12, torch=2.10, py=cp312)...\n  Best match: mamba_ssm-2.3.1+cu12torch2.10cxx11abiTRUE-cp312-cp312-linux_x86_64.whl\n  Downloaded: mamba_ssm-2.3.1+cu12torch2.10cxx11abiTRUE-cp312-cp312-linux_x86_64.whl (533.6 MB)\n\n=== Download summary ===\n  causal_conv1d: OK — causal_conv1d-1.6.1+cu12torch2.10cxx11abiTRUE-cp312-cp312-linux_x86_64.whl\n  mamba_ssm: OK — mamba_ssm-2.3.1+cu12torch2.10cxx11abiTRU