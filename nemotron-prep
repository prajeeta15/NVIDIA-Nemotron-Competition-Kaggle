    "print(f'Python  : {sys.version}')\n",
    "print(f'PyTorch : {TORCH_VER}')\n",
    "print(f'CUDA    : {CUDA_VER}')\n",
    "print(f'GPU     : {GPU_NAME}')\n",
    "\n",
    "# Determine the cu-tag for prebuilt wheel URLs\n",
    "cuda_major = int(CUDA_VER.split('.')[0]) if CUDA_VER else 0\n",
    "cuda_minor = int(CUDA_VER.split('.')[1]) if CUDA_VER and '.' in CUDA_VER else 0\n",
    "\n",
    "if cuda_major == 12 and cuda_minor >= 6:\n",
    "    CU_TAG = 'cu126'\n",
    "elif cuda_major == 12 and cuda_minor >= 4:\n",
    "    CU_TAG = 'cu124'\n",
    "elif cuda_major == 12 and cuda_minor >= 1:\n",
    "    CU_TAG = 'cu121'\n",
    "elif cuda_major == 12:\n",
    "    CU_TAG = 'cu122'\n",
    "else:\n",
    "    CU_TAG = 'cu121'\n",
    "    print(f'WARNING: Unexpected CUDA version {CUDA_VER}, defaulting to cu121')\n",
    "\n",
    "# Determine torch major.minor tag\n",
    "torch_parts = TORCH_VER.split('.')\n",
    "TORCH_TAG = f'{torch_parts[0]}.{torch_parts[1]}'\n",
    "\n",
    "print(f'\\ncu_tag   : {CU_TAG}')\n",
