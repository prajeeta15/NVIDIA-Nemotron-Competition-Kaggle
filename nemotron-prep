    "    (glob.glob(WHEEL_DIR + '/unsloth*.whl'),          'unsloth wheel'),\n",
    "    (glob.glob(WHEEL_DIR + '/trl*.whl'),              'trl wheel'),\n",
    "    (glob.glob(WHEEL_DIR + '/peft*.whl'),             'peft wheel'),\n",
    "    (glob.glob(WHEEL_DIR + '/bitsandbytes*.whl'),     'bitsandbytes wheel'),\n",
