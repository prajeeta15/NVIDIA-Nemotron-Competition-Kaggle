    "# Cell 0 — Detect environment\n",
    "import subprocess, sys, os\n",
    "import torch\n",
    "\n",
    "TORCH_VER = torch.__version__\n",
    "CUDA_VER  = torch.version.cuda or ''\n",
    "PY_VER    = f'{sys.version_info.major}{sys.version_info.minor}'\n",
