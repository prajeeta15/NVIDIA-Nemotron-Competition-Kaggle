    "# Cell 5 — Write version manifest\n",
    "\n",
    "import json, os\n",
    "import importlib.metadata as imd\n",
    "\n",
    "WHEEL_DIR = '/kaggle/working/wheelhouse'\n",
    "\n",
    "manifest_packages = [\n",
    "    'transformers', 'unsloth', 'unsloth_zoo', 'trl', 'peft',\n",
    "    'bitsandbytes', 'accelerate', 'datasets', 'huggingface_hub',\n",
    "    'causal_conv1d', 'mamba_ssm',\n",
    "]\n",
    "manifest = {}\n",
    "for pkg in manifest_packages:\n",
    "    try:\n",
    "        manifest[pkg] = imd.version(pkg)\n",
    "    except Exception:\n",
    "        manifest[pkg] = 'NOT_INSTALLED'\n",
    "\n",
    "with open(os.path.join(WHEEL_DIR, 'manifest.json'), 'w') as f:\n",
    "    json.dump(manifest, f, indent=2)\n",
    "\n",
    "print('Version manifest:')\n",
    "print(json.dumps(manifest, indent=2))\n",
    "\n",
    "# Verify critical packages are present\n",
    "critical = ['transformers', 'unsloth']\n",
    "missing  = [p for p in critical if manifest.get(p) == 'NOT_INSTALLED']\n",
    "assert not missing, f'Critical packages not installed: {missing}'\n",
    "\n",
    "# Verify transformers is a usable version (>=4.51)\n",
    "import transformers\n",
    "tf_major, tf_minor = [int(x) for x in transformers.__version__.split('.')[:2]]\n",
    "assert (tf_major, tf_minor) >= (4, 51), (\n",
    "    f'transformers {transformers.__version__} is too old (need >=4.51)'\n",
    ")\n",
    "print(f'\\ntransformers {transformers.__version__} — OK!')\n",
    "print('All critical packages OK!')"
   ]
