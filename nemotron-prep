    "print(f'py_tag   : cp{PY_VER}')\n",
    "\n",
    "# Store globally so later cells can use them\n",
    "import builtins\n",
    "builtins._NP_CU_TAG    = CU_TAG\n",
    "builtins._NP_TORCH_TAG = TORCH_TAG\n",
    "builtins._NP_PY_TAG    = f'cp{PY_VER}'\n",
