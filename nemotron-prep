    "# Cell 0 — Detect environment\n",
    "import subprocess, sys, os\n",
    "import torch\n",
    "\n",
    "TORCH_VER = torch.__version__\n",
    "CUDA_VER  = torch.version.cuda or ''\n",
    "PY_VER    = f'{sys.version_info.major}{sys.version_info.minor}'\n",
    "GPU_NAME  = torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NO GPU'\n",
    "\n",
    "print(f'Python  : {sys.version}')\n",
    "print(f'PyTorch : {TORCH_VER}')\n",
    "print(f'CUDA    : {CUDA_VER}')\n",
    "print(f'GPU     : {GPU_NAME}')\n",
    "\n",
    "# Determine simplified cu-tag (cu11, cu12, cu13) used in wheel filenames\n",
    "cuda_major = int(CUDA_VER.split('.')[0]) if CUDA_VER else 0\n",
    "if cuda_major >= 13:\n",
    "    CU_TAG = 'cu13'\n",
    "elif cuda_major == 12:\n",
    "    CU_TAG = 'cu12'\n",
    "elif cuda_major == 11:\n",
    "    CU_TAG = 'cu11'\n",
    "else:\n",
    "    CU_TAG = 'cu12'\n",
    "    print(f'WARNING: Unexpected CUDA {CUDA_VER}, defaulting to cu12')\n",
    "\n",
    "# Torch major.minor tag (e.g. '2.6')\n",
    "torch_parts = TORCH_VER.split('.')\n",
    "TORCH_TAG = f'{torch_parts[0]}.{torch_parts[1]}'\n",
    "\n",
    "PY_TAG = f'cp{PY_VER}'  # e.g. 'cp310'\n",
    "\n",
    "print(f'\\ncu_tag   : {CU_TAG}')\n",
    "print(f'torch_tag: {TORCH_TAG}')\n",
    "print(f'py_tag   : {PY_TAG}')\n",
    "\n",
    "import builtins\n",
    "builtins._NP_CU_TAG    = CU_TAG\n",
    "builtins._NP_TORCH_TAG = TORCH_TAG\n",
    "builtins._NP_PY_TAG    = PY_TAG\n",
    "\n",
    "assert torch.cuda.is_available(), 'GPU not detected — set accelerator to GPU!'\n",
    "print('\\nEnvironment OK.')"
   ]
