    "# Cell 1 — Install core deps (transformers version is now unsloth-driven)\n",
    "#\n",
    "# KEY CHANGE vs v3:\n",
    "#   unsloth >=2026.3 requires transformers>=5.0. Pinning to 4.51.x is no longer\n",
    "#   possible without breaking unsloth. We install unsloth WITH its deps, then\n",
    "#   install the rest, and verify the resolved transformers version is usable.\n",
    "\n",
    "import subprocess, sys\n",
    "\n",
    "def pip(*args, check=True):\n",
    "    r = subprocess.run(\n",
    "        [sys.executable, '-m', 'pip', 'install', '-q', *args],\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if r.returncode != 0:\n",
    "        print(f'STDERR: {r.stderr.strip()[:600]}')\n",
    "        if check:\n",
    "            raise RuntimeError(f'pip install failed: {args}')\n",
    "        return False\n",
    "    return True\n",
    "\n",
    "# 1a. Install unsloth WITH its deps — this resolves the correct transformers version\n",
    "print('Installing unsloth (with deps)...')\n",
    "pip('unsloth')\n",
    "\n",
    "# 1b. Install remaining core deps — versions left unconstrained so pip's resolver\n",
    "#     picks versions compatible with what unsloth just installed\n",
    "print('Installing remaining core deps...')\n",
    "pip(\n",
    "    'huggingface_hub>=0.25.0',\n",
    "    'datasets>=3.4.1',\n",
    "    'bitsandbytes>=0.45.5',\n",
    "    'unsloth_zoo',\n",
    "    'trl>=0.10.0',\n",
    "    'accelerate>=0.30.0',\n",
    "    'peft>=0.10.0',\n",
    "    'cut-cross-entropy',\n",
    "    'triton',\n",
    ")\n",
    "print('Core deps OK.')\n",
    "\n",
    "# 1c. Report resolved versions\n",
    "import importlib.metadata as imd\n",
    "key_pkgs = ['transformers', 'unsloth', 'trl', 'peft', 'bitsandbytes']\n",
    "print('\\nResolved versions:')\n",
    "for pkg in key_pkgs:\n",
    "    try:\n",
    "        print(f'  {pkg}: {imd.version(pkg)}')\n",
    "    except Exception:\n",
    "        print(f'  {pkg}: NOT FOUND')\n",
    "\n",
    "# 1d. Compatibility check (not a hard version pin)\n",
    "import transformers\n",
    "tf_major, tf_minor = [int(x) for x in transformers.__version__.split('.')[:2]]\n",
    "# unsloth 2026.x works with transformers >=4.51 (4.x) or >=5.0 (5.x)\n",
    "assert (tf_major, tf_minor) >= (4, 51), (\n",
    "    f'transformers {transformers.__version__} is too old — need >=4.51'\n",
    ")\n",
    "print(f'\\ntransformers {transformers.__version__} — OK!')"
   ]
