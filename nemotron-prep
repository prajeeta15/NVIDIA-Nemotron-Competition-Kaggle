    "import os, glob\n",
    "\n",
    "WHEEL_DIR    = '/kaggle/working/wheelhouse'\n",
    "PARQUET_PATH = '/kaggle/working/numinamath/train.parquet'\n",
    "\n",
    "print('=== /kaggle/working/ structure ===')\n",
    "total_size = 0\n",
    "for dirpath, _, filenames in os.walk('/kaggle/working'):\n",
    "    for f in sorted(filenames):\n",
    "        fp  = os.path.join(dirpath, f)\n",
    "        sz  = os.path.getsize(fp) / 1e6\n",
    "        total_size += sz\n",
    "        print(f'  {fp.replace(\"/kaggle/working/\", \"\")}: {sz:.1f} MB')\n",
    "print(f'\\nTotal: {total_size:.1f} MB')\n",
    "\n",
    "print('\\n=== Critical checks ===')\n",
    "checks = [\n",
