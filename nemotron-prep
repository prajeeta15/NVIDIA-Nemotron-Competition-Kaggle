    "# Cell 2 — Download prebuilt mamba_ssm + causal_conv1d binary wheels\n",
    "#\n",
    "# We do NOT compile from source. Instead we grab the correct prebuilt\n",
    "# binary wheel from GitHub that matches the detected CUDA + torch + Python versions.\n",
