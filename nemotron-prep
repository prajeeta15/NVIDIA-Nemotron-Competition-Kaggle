    "]\n",
    "\n",
    "for url in WHEELS:\n",
    "    fname = url.split('/')[-1]\n",
    "    dest = os.path.join(WHEEL_DIR, fname)\n",
    "    if os.path.exists(dest):\n",
    "        print(f'Already exists: {fname}')\n",
    "        continue\n",
    "    print(f'Downloading {fname}...')\n",
    "    try:\n",
    "        urllib.request.urlretrieve(url, dest)\n",
    "        size = os.path.getsize(dest) / 1e6\n",
    "        print(f'  OK: {size:.1f} MB')\n",
