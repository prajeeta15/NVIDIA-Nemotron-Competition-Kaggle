    "import subprocess, sys, glob, os, importlib.metadata as imd\n",
    "\n",
    "WHEEL_DIR = '/kaggle/working/wheelhouse'\n",
    "\n",
    "def install_whl(pattern, pkg_name):\n",
    "    matches = glob.glob(os.path.join(WHEEL_DIR, pattern))\n",
    "    if not matches:\n",
    "        print(f'  SKIP {pkg_name}: no wheel found ({pattern})')\n",
    "        return False\n",
    "    whl = matches[0]\n",
    "    print(f'  Installing {pkg_name} from {os.path.basename(whl)}...')\n",
    "    r = subprocess.run(\n",
    "        [sys.executable, '-m', 'pip', 'install', whl,\n",
    "         '--no-deps', '--force-reinstall', '-q'],\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if r.returncode != 0:\n",
    "        print(f'    ERROR: {r.stderr.strip()[:400]}')\n",
    "        return False\n",
    "    try:\n",
    "        ver = imd.version(pkg_name.replace('-', '_'))\n",
