    "# Cell 1 — Install core deps (transformers version driven by unsloth)\n",
    "import subprocess, sys\n",
    "\n",
    "def pip(*args, check=True):\n",
    "    r = subprocess.run(\n",
    "        [sys.executable, '-m', 'pip', 'install', '-q', *args],\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if r.returncode != 0:\n",
    "        print(f'STDERR: {r.stderr.strip()[:600]}')\n",
    "        if check:\n",
    "            raise RuntimeError(f'pip install failed: {args}')\n",
    "        return False\n",
    "    return True\n",
    "\n",
    "# Install unsloth first — it owns the transformers version constraint\n",
    "print('Installing unsloth (with deps)...')\n",
    "pip('unsloth')\n",
    "\n",
    "print('Installing remaining core deps...')\n",
    "pip(\n",
    "    'huggingface_hub>=0.25.0',\n",
    "    'datasets>=3.4.1',\n",
    "    'bitsandbytes>=0.45.5',\n",
    "    'unsloth_zoo',\n",
    "    'trl>=0.10.0',\n",
    "    'accelerate>=0.30.0',\n",
    "    'peft>=0.10.0',\n",
    "    'cut-cross-entropy',\n",
    "    'triton',\n",
    ")\n",
    "print('Core deps OK.')\n",
    "\n",
    "import importlib.metadata as imd\n",
    "print('\\nResolved versions:')\n",
    "for pkg in ['transformers', 'unsloth', 'trl', 'peft', 'bitsandbytes']:\n",
    "    try:\n",
    "        print(f'  {pkg}: {imd.version(pkg)}')\n",
    "    except Exception:\n",
    "        print(f'  {pkg}: NOT FOUND')\n",
    "\n",
    "import transformers\n",
    "tf_major, tf_minor = [int(x) for x in transformers.__version__.split('.')[:2]]\n",
    "assert (tf_major, tf_minor) >= (4, 51), (\n",
    "    f'transformers {transformers.__version__} is too old — need >=4.51'\n",
    ")\n",
    "print(f'\\ntransformers {transformers.__version__} — OK!')"
   ]
