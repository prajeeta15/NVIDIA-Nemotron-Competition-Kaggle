    "\n",
    "import urllib.request, os, glob, re, json\n",
    "import torch\n",
    "\n",
    "WHEEL_DIR = '/kaggle/working/wheelhouse'\n",
    "os.makedirs(WHEEL_DIR, exist_ok=True)\n",
    "\n",
    "CU_TAG    = getattr(__builtins__, '_NP_CU_TAG',    'cu124')\n",
    "TORCH_TAG = getattr(__builtins__, '_NP_TORCH_TAG', '2.6')\n",
    "PY_TAG    = getattr(__builtins__, '_NP_PY_TAG',    'cp312')\n",
    "\n",
    "# Map of repo → (release_tag, base_url)\n",
    "REPOS = {\n",
    "    'causal_conv1d': {\n",
    "        'tag': 'v1.5.0',\n",
    "        'base_url': 'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.5.0/',\n",
    "        'fallback_urls': [\n",
    "            'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.4.0/',\n",
    "            'https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.3.0/',\n",
    "        ]\n",
    "    },\n",
    "    'mamba_ssm': {\n",
    "        'tag': 'v2.2.4',\n",
    "        'base_url': 'https://github.com/state-spaces/mamba/releases/download/v2.2.4/',\n",
    "        'fallback_urls': [\n",
    "            'https://github.com/state-spaces/mamba/releases/download/v2.3.1/',\n",
    "        ]\n",
    "    },\n",
    "}\n",
    "\n",
    "def build_wheel_name(pkg_base, ver, cu_tag, torch_tag, py_tag, cxx='FALSE'):\n",
    "    tag = f'{cu_tag}torch{torch_tag}cxx11abi{cxx}'\n",
    "    return f'{pkg_base}-{ver}+{tag}-{py_tag}-{py_tag}-linux_x86_64.whl'\n",
    "\n",
    "def try_download(url, dest):\n",
    "    try:\n",
    "        urllib.request.urlretrieve(url, dest)\n",
    "        size = os.path.getsize(dest) / 1e6\n",
    "        if size < 0.1:  # tiny file = 404 HTML, not a wheel\n",
    "            os.remove(dest)\n",
    "            return False\n",
    "        print(f'  Downloaded: {os.path.basename(dest)} ({size:.1f} MB)')\n",
    "        return True\n",
    "    except Exception:\n",
    "        if os.path.exists(dest):\n",
    "            os.remove(dest)\n",
    "        return False\n",
    "\n",
    "TARGETS = [\n",
    "    ('causal-conv1d', 'causal_conv1d', '1.5.0', 'causal_conv1d'),\n",
    "    ('mamba-ssm',     'mamba_ssm',     '2.2.4', 'mamba_ssm'),\n",
    "]\n",
    "\n",
    "# Remove any stale non-wheel archives\n",
    "for bad_ext in ['tar.gz', 'zip']:\n",
    "    for bad in glob.glob(os.path.join(WHEEL_DIR, f'*causal*{bad_ext}')) + \\\n",
    "               glob.glob(os.path.join(WHEEL_DIR, f'*mamba*{bad_ext}')):\n",
    "        os.remove(bad)\n",
    "        print(f'Removed stale archive: {os.path.basename(bad)}')\n",
    "\n",
    "download_results = {}\n",
    "\n",
    "for pip_name, pkg_base, ver, repo_key in TARGETS:\n",
    "    print(f'\\n--- {pkg_base} ---')\n",
    "\n",
    "    existing = glob.glob(os.path.join(WHEEL_DIR, f'{pkg_base}*.whl'))\n",
    "    if existing:\n",
    "        print(f'  Already in wheelhouse: {os.path.basename(existing[0])}')\n",
    "        download_results[pkg_base] = existing[0]\n",
    "        continue\n",
    "\n",
    "    repo = REPOS[repo_key]\n",
    "    all_bases  = [repo['base_url']] + repo.get('fallback_urls', [])\n",
    "    all_torch  = [TORCH_TAG, '2.6', '2.5', '2.4', '2.3']\n",
    "    all_cu     = [CU_TAG, 'cu124', 'cu122', 'cu121', 'cu118']\n",
    "\n",
    "    found = False\n",
    "    for base_url in all_bases:\n",
    "        for t_tag in all_torch:\n",
    "            for c_tag in all_cu:\n",
    "                for cxx in ['FALSE', 'TRUE']:\n",
    "                    whl_name = build_wheel_name(pkg_base, ver, c_tag, t_tag, PY_TAG, cxx)\n",
    "                    url  = base_url + whl_name\n",
    "                    dest = os.path.join(WHEEL_DIR, whl_name)\n",
    "                    if try_download(url, dest):\n",
    "                        download_results[pkg_base] = dest\n",
    "                        found = True\n",
    "                        break\n",
    "                if found: break\n",
    "            if found: break\n",
    "        if found: break\n",
    "\n",
    "    if not found:\n",
    "        print(f'  FAILED: could not find a binary wheel for {pkg_base}')\n",
    "        print(f'  Torch: {torch.__version__}, CUDA: {torch.version.cuda}, Python: {PY_TAG}')\n",
    "        print(f'  Releases: https://github.com/{\"Dao-AILab/causal-conv1d\" if pkg_base==\"causal_conv1d\" else \"state-spaces/mamba\"}/releases')\n",
    "        download_results[pkg_base] = None\n",
    "\n",
    "print('\\n=== Download summary ===')\n",
    "for k, v in download_results.items():\n",
    "    print(f'  {k}: {\"OK — \" + os.path.basename(v) if v else \"MISSING (optional)\"}')\n",
    "\n",
    "missing = [k for k, v in download_results.items() if not v]\n",
    "if missing:\n",
    "    print(f'\\nINFO: No prebuilt wheels for {missing}. Training notebook will skip mamba.')\n",
    "else:\n",
    "    print('\\nAll mamba/causal_conv1d wheels downloaded!')"
